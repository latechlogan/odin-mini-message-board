<!DOCTYPE html>
<html lang="en" class="p-8">
  <%- include('shared/head') %>
  <body class="sm:container mx-auto">
    <h1 class="text-4xl">Post a New Message</h1>
    <form
      method="POST"
      action="/new"
      class="mt-10 flex flex-col"
      id="newMessageForm"
    >
      <div class="flex flex-col mb-4">
        <label for="username" class="mb-2">Your Name:</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= username || '' %>"
          required
          class="border px-4 py-2 rounded <%= errors && errors.username ? 'border-red-800 focus:border-red-800' : 'border-gray-300 focus:border-blue-500' %>"
        />
      </div>
      <% if (errors && errors.username) { %>
      <p class="error mb-8 text-red-800"><%= errors.username.msg %></p>
      <% } %>
      <div class="flex flex-col mb-4">
        <label for="message" class="mb-2">Message:</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="border px-4 py-2 rounded <%= errors && errors.username ? 'border-red-800 focus:border-red-800' : 'border-gray-300 focus:border-blue-500' %>"
        >
<%= message || '' %></textarea
        >
      </div>
      <% if (errors && errors.message) { %>
      <p class="error mb-8 text-red-800"><%= errors.message.msg %></p>
      <% } %>
    </form>
    <button
      type="submit"
      form="newMessageForm"
      class="inline-block py-2 px-4 bg-green-600 text-white rounded"
    >
      Submit Message
    </button>
    <a href="/" class="inline-block py-2 px-4 ml-4 text-gray-500 rounded"
      >Cancel</a
    >
  </body>
</html>
